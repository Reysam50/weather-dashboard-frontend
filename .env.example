# Copy to .env.local and fill in real values. Never commit .env.local.

# Same-origin deployment (ADR-0003) — backend is reverse-proxied by Nginx
# alongside the frontend, so this is typically a relative path or the droplet's
# own address, not a separate domain.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_WS_URL=/ws
