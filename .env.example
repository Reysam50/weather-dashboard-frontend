# Copy to .env.local and fill in real values. Never commit .env.local.

# Same-origin deployment (ADR-0003) — backend is reverse-proxied by Nginx
# alongside the frontend, so this is typically a relative path or the droplet's
# own address, not a separate domain.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# next.config.mjs proxies /api/* to the Django backend (default http://127.0.0.1:8000);
# only set this if the backend lives elsewhere:
# BACKEND_ORIGIN=http://127.0.0.1:8000
# Live updates. The WebSocket connects straight to the backend (Next's rewrites
# don't forward WebSocket upgrades); same host => the auth cookie is sent with the
# handshake. For local dev use the backend's address; behind one domain/nginx use
# e.g. wss://your.domain/ws (see backend docs/DEPLOYMENT.md).
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Dev-only default login — lets you actually log in and reach the
# dashboard before a real backend exists. Used automatically ONLY when
# POST /auth/login or GET /auth/me fail with a network error (no backend
# reachable) rather than a real HTTP response — see lib/mockSession.ts.
# Once a real backend exists these are never consulted; delete them
# whenever you want to turn this off explicitly.
NEXT_PUBLIC_DEV_LOGIN_EMAIL=kai@caizwork.mw
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=telemetry-dev-2026